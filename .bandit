[bandit]
# Skip false-positive test IDs:
#   B101 - assert used (acceptable in non-compiled research code)
#   B105 - hardcoded_password_string: false-positive on enum value strings
#   B311 - pseudo-random: seeded RNG is intentional for reproducible eval
#   B404 - subprocess import: needed for offline SQL generation utility
#   B603 - subprocess without shell: inputs are controlled/internal
#   B607 - start process partial path: not applicable
skips = B101,B105,B311,B404,B603,B607

# Exclude dirs
exclude = .venv,tests
