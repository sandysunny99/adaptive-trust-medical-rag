# Environment variables for Adaptive Trust-Aware Medical RAG
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://rag_user:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/medical_rag

# ── LLM API Keys (set at Phase 8) ─────────────────────────────
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# ── Application Settings ──────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Risk & Trust Thresholds ───────────────────────────────────
# R0 (Informational): 0.30
# R1 (Low): 0.45
# R2 (Medium): 0.60
# R3 (High): 0.75
TRUST_THRESHOLD_R0=0.30
TRUST_THRESHOLD_R1=0.45
TRUST_THRESHOLD_R2=0.60
TRUST_THRESHOLD_R3=0.75
