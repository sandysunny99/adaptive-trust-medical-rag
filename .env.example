# ==============================================================================
# ADAPTIVE TRUST-AWARE MEDICAL RAG — configuration template (placeholders only)
# Copy to .env.local (or .env) and fill in your own keys. Never commit real values.
# Precedence: process environment > .env.local > .env > defaults in api/app.py.
# Files are read from the repository root, whatever the working directory.
# ==============================================================================

# ── Live application: text LLM (api/app.py build_llm_router) ─────────────────────
# Primary provider: groq | nvidia | cloudflare (LLM_PRIMARY_PROVIDER is read if this is unset).
LLM_PROVIDER=groq
# Comma-separated fallbacks after the primary. Unset = every provider with credentials.
LLM_FALLBACK_PROVIDERS=cloudflare
LLM_FAILOVER_ENABLED=true
# LLM_REQUEST_DEADLINE_S=120

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_S=30

CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_TIMEOUT_S=30

# NVIDIA text model. Check that your account can call the model: the catalog can list a model
# that returns 404 "not found for account" (NVIDIA_API_KEY is used if NVIDIA_LLM_API_KEY is unset).
NVIDIA_LLM_API_KEY=your_nvidia_llm_api_key_here
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_LLM_TIMEOUT_S=30

# ── Live application: prescription image extraction ───────────────────────────────
# NVIDIA is primary (NVIDIA_API_KEY is used if NVIDIA_OCR_API_KEY is unset).
NVIDIA_OCR_API_KEY=your_nvidia_ocr_api_key_here
NVIDIA_OCR_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_OCR_BASE_URL=https://integrate.api.nvidia.com/v1
# Backup: a Groq image-capable model (uses GROQ_API_KEY). Set to empty to disable the backup,
# so images are never sent to Groq.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional second NVIDIA vision model, tried before the Groq backup.
# VISION_FALLBACK_MODEL=
# Per attempt / total, in seconds.
# VISION_TIMEOUT_S=30
# VISION_DEADLINE_S=75

# Legacy single NVIDIA key (also read by the annotation scripts).
# NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Research stack only (llm_routing/config.py, llm_backend/__init__.py, annotation
#    engine, phase15 runner, proof scripts). The live application does not read these. ──
# LLM_PRIMARY_PROVIDER=groq
# LLM_FALLBACK_PROVIDER=gemini
# LLM_TERTIARY_PROVIDER_ENABLED=false
# LLM_SECRET_REDACTION=true
# LLM_LOG_RAW_KEYS=false
# CLOUDFLARE_ENABLED=false
# CLOUDFLARE_FREE_ONLY_MODE=true
# HF_FREE_ONLY_MODE=true
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-model-id
# HF_TOKEN=your_huggingface_token_here
# HF_MODEL=org/model-id

# Not read by the application: the port and host are set on the uvicorn command line, CORS
# origins and the 5 MB upload limit are fixed in code.
