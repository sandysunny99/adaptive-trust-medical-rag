{
  "dangerous-command-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c python .agents\\scripts\\check_dangerous_cmd.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "secret-detection-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c python .agents\\scripts\\pre_commit_secret_scan.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "medical-context-injector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "cmd /c python .agents\\scripts\\inject_medical_context.py",
        "timeout": 5
      }
    ]
  }
}
