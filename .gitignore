# MLflow
mlruns/
mlartifacts/

# Evaluation — CRITICAL leakage prevention
# The final test set is committed but must never be indexed
# evaluation/ IS committed to Git (it's version-controlled data)
# But these runtime outputs are not:
evaluation/results/
evaluation/tmp/

# Research outputs (generated, not committed)
research/results/
research/figures/
research/tables/

# Backup
.antigravity-backup/

# Temporary
tmp/
temp/
scratch/

# Trivy / Security scan outputs
*.sarif
sbom.*.json
trivy-report.json

# SonarQube
.sonar/
.scannerwork/

