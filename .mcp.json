{
  "mcpServers": {
    "medical-rag": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--no-sync", "python", ".agents/scripts/mcp_server.py"],
      "env": {
        "PYTHONPATH": "src"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser", "chrome",
        "--isolated",
        "--allowed-origins", "http://localhost:5173;http://127.0.0.1:5173;http://localhost:4173;http://127.0.0.1:4173;http://localhost:8000;http://127.0.0.1:8000",
        "--output-dir", ".playwright-mcp"
      ]
    }
  }
}
